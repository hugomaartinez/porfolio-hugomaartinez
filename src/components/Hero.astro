---
import Icon from "./Icon.astro";
import { EXPERIENCE, PROFILE, PROJECTS } from "@/data/portfolio";

const currentJob = EXPERIENCE.find((job) => job.current);
const yearsOfExperience = Math.floor(
  (Date.now() - PROFILE.careerStart.getTime()) / (365.25 * 24 * 60 * 60 * 1000),
);

const stats = [
  { value: `${yearsOfExperience}+`, label: "años creando software en empresa" },
  { value: `${EXPERIENCE.length}`, label: "empresas, todas del sector de la automoción" },
  { value: `${PROJECTS.length}`, label: "proyectos personales publicados" },
];
---

<div class="grid items-center gap-14 lg:grid-cols-[1fr_auto] lg:gap-16">
  <div>
    {
      currentJob && (
        <a
          href={currentJob.link}
          target="_blank"
          rel="noopener"
          class="hero-in group inline-flex max-w-full items-center gap-2.5 rounded-full border border-line/10 bg-surface/70 py-1.5 pl-3 pr-2 text-[13px] text-muted backdrop-blur transition hover:border-accent/40 hover:text-fg sm:text-sm"
        >
          <span class="relative flex size-2 shrink-0">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60" />
            <span class="relative inline-flex size-2 rounded-full bg-emerald-500" />
          </span>
          <span class="truncate">
            {currentJob.role} en <strong class="font-semibold text-fg">{currentJob.company}</strong>
          </span>
          <Icon
            name="arrow-up-right"
            class="size-3.5 shrink-0 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          />
        </a>
      )
    }

    <p class="hero-in mt-10 font-mono text-sm text-muted" style="--i: 1">Hola, soy</p>
    <h1
      class="hero-in mt-3 text-[clamp(2.9rem,9vw,5.75rem)] font-semibold leading-[0.92] tracking-[-0.045em]"
      style="--i: 2"
    >
      Hugo Martínez<br />
      <span class="text-muted/70">Barros</span><span class="text-accent">.</span>
    </h1>

    <p class="hero-in mt-8 max-w-xl text-pretty text-lg leading-relaxed text-muted sm:text-xl" style="--i: 3">
      <strong class="font-medium text-fg">Técnico de producto</strong> en Spiga+, el software de gestión
      para concesionarios y talleres. Antes, más de dos años como <strong class="font-medium text-fg"
        >desarrollador Java y Angular</strong
      >, con integraciones para fabricantes como Renault, BYD o Hyundai.
    </p>

    <div class="hero-in mt-9 flex flex-wrap gap-3" style="--i: 4">
      <a href={`mailto:${PROFILE.email}`} class="btn btn-primary">
        <Icon name="mail" />
        Escríbeme
      </a>
      <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
        <Icon name="linkedin" />
        LinkedIn
      </a>
      <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
        <Icon name="github" />
        GitHub
      </a>
      <a href={PROFILE.cv} target="_blank" rel="noopener" class="btn btn-ghost">
        <Icon name="file" />
        Ver CV
      </a>
    </div>
  </div>

  <figure class="hero-in relative mx-auto hidden w-[300px] lg:block" style="--i: 3">
    <div
      class="photo-card rotate-[2.5deg] rounded-[1.75rem] border border-line/10 bg-surface p-2.5 shadow-2xl shadow-black/10 transition duration-500 hover:rotate-0"
    >
      <img
        src="/me.jpeg"
        alt="Retrato de Hugo Martínez Barros"
        width="800"
        height="800"
        class="aspect-[4/5] w-full rounded-[1.25rem] object-cover"
        fetchpriority="high"
      />
      <figcaption class="flex items-center justify-between px-2 pb-1 pt-3 font-mono text-[11px] text-muted">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="map-pin" class="size-3.5 text-accent" />
          {PROFILE.location}
        </span>
        <span>42.11° N</span>
      </figcaption>
    </div>
    <span
      class="absolute -left-6 bottom-16 -rotate-6 rounded-full bg-fg px-3 py-1 font-mono text-[11px] text-bg shadow-lg"
      >Java · Angular · IA</span
    >
  </figure>
</div>

<dl class="hero-in mt-20 grid border-t border-line/10 sm:grid-cols-3" style="--i: 5">
  {
    stats.map((stat) => (
      <div class="flex flex-row-reverse items-baseline justify-end gap-4 border-b border-line/10 py-5 sm:flex-col-reverse sm:items-start sm:justify-start sm:gap-2 sm:border-b-0 sm:border-l sm:px-6 sm:first:border-l-0 sm:first:pl-0">
        <dt class="text-sm text-muted">{stat.label}</dt>
        <dd class="text-4xl font-semibold tracking-tight sm:text-5xl">{stat.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .hero-in {
    animation: hero-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in {
      animation: none;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(6px);
    }
  }
</style>
