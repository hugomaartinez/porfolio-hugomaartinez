---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { title: "Experiencia", id: "experiencia" },
  { title: "Proyectos", id: "proyectos" },
  { title: "Stack", id: "stack", desktopOnly: true },
  { title: "Sobre mí", id: "sobre-mi" },
  { title: "Contacto", id: "contacto", desktopOnly: true },
];
---

<header class="fixed inset-x-0 top-3 z-50 flex justify-center px-4">
  <nav
    aria-label="Principal"
    class="flex items-center gap-0.5 rounded-full border border-line/10 bg-surface/75 p-1 text-[13px] shadow-lg shadow-black/[0.04] backdrop-blur-xl sm:text-sm"
  >
    <a
      href="#inicio"
      aria-label="Ir al inicio"
      class="mr-1 grid size-8 shrink-0 place-items-center rounded-full bg-fg text-[11px] font-bold tracking-tight text-bg transition hover:scale-105"
      >HM</a
    >
    {
      navItems.map((item) => (
        <a
          href={`#${item.id}`}
          data-nav={item.id}
          class:list={[
            "nav-link rounded-full px-2.5 py-1.5 text-muted transition-colors hover:text-fg sm:px-3",
            item.desktopOnly && "hidden sm:block",
          ]}
        >
          {item.title}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>

<style>
  .nav-link[aria-current] {
    @apply bg-line/[0.07] text-fg;
  }
</style>

<script>
  // Marca en el menú la sección que se está viendo
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav]");
  // El inicio no tiene enlace propio, pero lo observamos para desmarcar el menú al volver arriba
  const sections = ["inicio", ...[...links].map((link) => link.dataset.nav ?? "")]
    .map((id) => document.getElementById(id))
    .filter((section): section is HTMLElement => section !== null);

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((link) => {
          if (link.dataset.nav === entry.target.id) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );

  sections.forEach((section) => observer.observe(section));
</script>
