---
import Icon from "./Icon.astro";
import { PROJECTS } from "@/data/portfolio";

const regularCount = PROJECTS.filter((project) => !project.featured).length;
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {
    PROJECTS.map((project, index) => {
      const url = project.link ?? project.github;
      const host = project.link ? new URL(project.link).host : "github.com";

      return (
        <article
          data-reveal
          data-spotlight
          style={`--delay: ${(index % 3) * 90}ms`}
          class:list={[
            "card group flex flex-col overflow-hidden",
            // En tablet (2 columnas), la última tarjeta ocupa todo el ancho si queda sola
            index === PROJECTS.length - 1 && regularCount % 2 === 1 && "sm:col-span-2 lg:col-span-1",
            project.featured && "sm:col-span-2 md:grid md:grid-cols-[1.35fr_1fr] lg:col-span-3",
          ]}
        >
          <a
            href={url}
            target="_blank"
            rel="noopener"
            tabindex="-1"
            aria-hidden="true"
            class:list={["block p-3", project.featured ? "md:p-4 md:pr-0" : "pb-0"]}
          >
            <div class="overflow-hidden rounded-xl border border-line/10 bg-bg">
              <div class="flex items-center gap-1.5 border-b border-line/10 px-3 py-2">
                <span class="size-2 rounded-full bg-line/20" />
                <span class="size-2 rounded-full bg-line/20" />
                <span class="size-2 rounded-full bg-line/20" />
                <span class="ml-2 truncate rounded bg-line/[0.05] px-2 py-0.5 font-mono text-[10.5px] text-muted">
                  {host}
                </span>
              </div>
              <div class="aspect-[1200/713] overflow-hidden">
                <img
                  src={project.image}
                  alt={project.alt}
                  width="1200"
                  height="713"
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover object-top transition duration-700 ease-out group-hover:scale-[1.04]"
                />
              </div>
            </div>
          </a>

          <div class:list={["flex flex-1 flex-col p-6", project.featured && "md:justify-center md:p-10"]}>
            {project.featured && (
              <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.18em] text-accent">Proyecto destacado</p>
            )}
            <h3 class:list={["font-semibold tracking-tight", project.featured ? "text-2xl md:text-3xl" : "text-xl"]}>
              {project.title}
            </h3>
            <p class="mt-2.5 text-pretty text-[15px] leading-relaxed text-muted">{project.description}</p>

            <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={`Tecnologías de ${project.title}`}>
              {project.tags.map((tag) => (
                <li class="chip">{tag}</li>
              ))}
            </ul>

            <div class="mt-auto flex flex-wrap gap-2 pt-6">
              {project.link && (
                <a href={project.link} target="_blank" rel="noopener" class="btn btn-ghost !px-3.5 !py-1.5">
                  <Icon name="arrow-up-right" class="size-3.5" />
                  Ver online<span class="sr-only">: {project.title}</span>
                </a>
              )}
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost !px-3.5 !py-1.5">
                  <Icon name="github" class="size-3.5" />
                  Código<span class="sr-only"> de {project.title}</span>
                </a>
              )}
            </div>
          </div>
        </article>
      );
    })
  }
</div>
