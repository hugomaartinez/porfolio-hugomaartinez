---
import { PROFILE } from "@/data/portfolio";

const currentYear = new Date().getFullYear();
---

<footer class="mx-auto mt-24 w-full max-w-5xl px-4 pb-10 lg:px-0">
  <div
    class="flex flex-col gap-4 border-t border-line/10 pt-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>
      &copy; {currentYear}
      {PROFILE.name}. Diseñado y programado por mí con Astro y Tailwind CSS.
    </p>
    <ul class="flex gap-5">
      <li><a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="transition hover:text-fg">LinkedIn</a></li>
      <li><a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="transition hover:text-fg">GitHub</a></li>
      <li><a href="#inicio" class="transition hover:text-fg">Volver arriba ↑</a></li>
    </ul>
  </div>
</footer>
