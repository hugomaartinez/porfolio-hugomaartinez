---
interface Props {
  index: string;
  kicker: string;
  title: string;
  lead?: string;
}

const { index, kicker, title, lead } = Astro.props;
---

<header class="mb-10 sm:mb-14" data-reveal>
  <p class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.18em] text-accent">
    <span>{index}</span>
    <span class="h-px w-8 bg-accent/40"></span>
    <span>{kicker}</span>
  </p>
  <h2 class="mt-4 text-balance text-3xl font-semibold tracking-[-0.03em] sm:text-[2.6rem] sm:leading-[1.1]">
    {title}
  </h2>
  {lead && <p class="mt-4 max-w-2xl text-pretty text-muted sm:text-lg">{lead}</p>}
</header>
