---
interface Props {
  index: string;
  title: string;
}

const { index, title } = Astro.props;
---

<header class="mb-10 sm:mb-14" data-reveal>
  <p aria-hidden="true" class="flex items-center gap-3 font-mono text-xs tracking-[0.18em] text-accent">
    <span>{index}</span>
    <span class="h-px w-8 bg-accent/40"></span>
  </p>
  <h2 class="mt-4 text-balance text-3xl font-semibold tracking-[-0.03em] sm:text-[2.6rem] sm:leading-[1.1]">
    {title}
  </h2>
</header>
