---
import Icon from "./Icon.astro";
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Cambiar entre tema claro y oscuro"
  class="ml-0.5 grid size-8 shrink-0 place-items-center rounded-full text-muted transition hover:bg-line/[0.07] hover:text-fg"
>
  <Icon name="moon" class="size-[18px] dark:hidden" />
  <Icon name="sun" class="hidden size-[18px] dark:block" />
</button>

<script>
  type ViewTransitionDocument = Document & {
    startViewTransition?: (update: () => void) => { ready: Promise<void> };
  };

  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

  const getStored = () => {
    try {
      return localStorage.getItem("theme");
    } catch {
      return null;
    }
  };

  const setTheme = (dark: boolean) => {
    root.classList.toggle("dark", dark);
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
  };

  button?.addEventListener("click", () => {
    const dark = !root.classList.contains("dark");
    const doc = document as ViewTransitionDocument;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!doc.startViewTransition || reduceMotion) {
      setTheme(dark);
      return;
    }

    // Círculo que crece desde el botón hasta cubrir la pantalla
    const { left, top, width, height } = button.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    doc.startViewTransition(() => setTheme(dark)).ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 550, easing: "cubic-bezier(0.4, 0, 0.2, 1)", pseudoElement: "::view-transition-new(root)" },
      );
    });
  });

  // Si el usuario no ha elegido tema, seguimos el del sistema
  systemDark.addEventListener("change", (event) => {
    const stored = getStored();
    if (stored !== "dark" && stored !== "light") root.classList.toggle("dark", event.matches);
  });
</script>
