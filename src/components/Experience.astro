---
import Icon from "./Icon.astro";
import { EXPERIENCE } from "@/data/portfolio";
---

<ol class="relative space-y-5 sm:space-y-0">
  {
    EXPERIENCE.map((job) => (
      <li
        data-reveal
        class="relative grid gap-3 sm:grid-cols-[180px_1fr] sm:gap-12 sm:pb-10 sm:before:absolute sm:before:bottom-0 sm:before:left-[204px] sm:before:top-3 sm:before:w-px sm:before:bg-line/10 sm:last:pb-0 sm:last:before:hidden"
      >
        <div class="self-start sm:sticky sm:top-28 sm:pt-6 sm:text-right">
          <p class="font-mono text-xs text-fg/80">{job.period}</p>
          {job.location && <p class="mt-1 text-xs text-muted">{job.location}</p>}
          <span
            aria-hidden="true"
            class:list={[
              "absolute -right-[29px] top-[29px] hidden size-[11px] rounded-full border-2 border-bg sm:block",
              job.current ? "bg-accent ring-4 ring-accent/20" : "bg-line/30",
            ]}
          />
        </div>

        <article
          data-spotlight
          class:list={["card p-6 sm:p-7", job.current && "card-highlight"]}
        >
          <header class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
            <div>
              <h3 class="text-xl font-semibold tracking-tight">{job.role}</h3>
              {job.link ? (
                <a
                  href={job.link}
                  target="_blank"
                  rel="noopener"
                  class="group mt-0.5 inline-flex items-center gap-1 text-muted transition hover:text-accent"
                >
                  {job.company}
                  <Icon
                    name="arrow-up-right"
                    class="size-3.5 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  />
                </a>
              ) : (
                <p class="mt-0.5 text-muted">{job.company}</p>
              )}
            </div>
            {job.current && (
              <span class="rounded-full bg-accent/10 px-2.5 py-1 font-mono text-[11px] font-medium uppercase tracking-wider text-accent">
                Ahora
              </span>
            )}
          </header>

          {job.summary && <p class="mt-4 text-pretty text-fg/90">{job.summary}</p>}

          <ul class="mt-4 space-y-2.5 text-[15px] leading-relaxed text-muted">
            {job.highlights.map((highlight) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-[0.6em] h-px w-3 shrink-0 bg-accent/60" />
                <span class="text-pretty">{highlight}</span>
              </li>
            ))}
          </ul>

          <ul class="mt-6 flex flex-wrap gap-1.5" aria-label={`Tecnologías en ${job.company}`}>
            {job.tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))}
          </ul>
        </article>
      </li>
    ))
  }
</ol>
